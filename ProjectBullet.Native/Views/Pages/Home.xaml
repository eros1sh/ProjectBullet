<Page x:Class="ProjectBullet.Native.Views.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:converters="clr-namespace:ProjectBullet.Native.Converters"
      xmlns:local="clr-namespace:ProjectBullet.Native.Views.Pages"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="780"
      Title="Home">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   FontSize="24"
                   TextWrapping="Wrap"
                   Margin="0 0 0 15"
                   Foreground="{DynamicResource ForegroundMain}">
            Welcome to <Bold>ProjectBullet</Bold>
        </TextBlock>

        <!-- Stat Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0 0 0 15">
            <!-- Total Hits -->
            <Border Background="{DynamicResource BackgroundSecondary}"
                    CornerRadius="5" Margin="0 0 8 0" Padding="15 10">
                <StackPanel>
                    <TextBlock Text="Total Hits" FontSize="12"
                               Foreground="{DynamicResource ForegroundMain}" Opacity="0.7"/>
                    <TextBlock Text="{Binding TotalHits}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundGood}"/>
                </StackPanel>
            </Border>

            <!-- Active Jobs -->
            <Border Background="{DynamicResource BackgroundSecondary}"
                    CornerRadius="5" Margin="4 0" Padding="15 10">
                <StackPanel>
                    <TextBlock Text="Active Jobs" FontSize="12"
                               Foreground="{DynamicResource ForegroundMain}" Opacity="0.7"/>
                    <TextBlock Text="{Binding ActiveJobs}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundCustom}"/>
                </StackPanel>
            </Border>

            <!-- Total Configs -->
            <Border Background="{DynamicResource BackgroundSecondary}"
                    CornerRadius="5" Margin="4 0" Padding="15 10">
                <StackPanel>
                    <TextBlock Text="Total Configs" FontSize="12"
                               Foreground="{DynamicResource ForegroundMain}" Opacity="0.7"/>
                    <TextBlock Text="{Binding TotalConfigs}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundMain}"/>
                </StackPanel>
            </Border>

            <!-- Total Proxies -->
            <Border Background="{DynamicResource BackgroundSecondary}"
                    CornerRadius="5" Margin="8 0 0 0" Padding="15 10">
                <StackPanel>
                    <TextBlock Text="Total Proxies" FontSize="12"
                               Foreground="{DynamicResource ForegroundMain}" Opacity="0.7"/>
                    <TextBlock Text="{Binding TotalProxies}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundMain}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Active Jobs Header -->
        <TextBlock Grid.Row="2" Text="Active Jobs" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource ForegroundMain}" Margin="0 0 0 5"/>

        <!-- Active Jobs List -->
        <ListView Grid.Row="3"
                  Foreground="{DynamicResource ForegroundMain}"
                  Background="Transparent"
                  ItemsSource="{Binding ActiveJobsList}"
                  BorderThickness="1"
                  Margin="0 0 0 10">

            <ListView.Style>
                <Style TargetType="{x:Type ListView}" />
            </ListView.Style>

            <ListView.Resources>
                <Style x:Key="GridViewColumnHeaderGripper" TargetType="Thumb">
                    <Setter Property="Width" Value="18" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <Rectangle HorizontalAlignment="Center" Width="1" Fill="{TemplateBinding Background}" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                <Grid>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="Black" Background="Transparent">
                                        <TextBlock x:Name="ContentHeader" Text="{TemplateBinding Content}" Padding="5,5,5,0" Width="{TemplateBinding Width}" TextAlignment="Left" />
                                    </Border>
                                    <Thumb x:Name="PART_HeaderGripper"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,-9,0"
                                         Style="{StaticResource GridViewColumnHeaderGripper}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}" />
                    <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Century Gothic" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Background="{TemplateBinding Background}"
                                        Padding="0"
                                        SnapsToDevicePixels="true">
                                    <GridViewRowPresenter
                                        HorizontalAlignment="Left"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <GridViewColumn Width="200" Header="Config" DisplayMemberBinding="{Binding ConfigName}" />
                    <GridViewColumn Width="100" Header="Status" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Width="100" Header="Progress" DisplayMemberBinding="{Binding Progress}" />
                    <GridViewColumn Width="80" Header="CPM" DisplayMemberBinding="{Binding CPM}" />
                    <GridViewColumn Width="80" Header="Hits" DisplayMemberBinding="{Binding Hits}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Quick Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0 0 0 10">
            <Button x:Name="newJobButton" Click="NewJob"
                    Margin="0 5 5 5" Style="{StaticResource StyledPrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterialDesign Kind="Add" />
                    <TextBlock VerticalAlignment="Center" Margin="5 0">New Job</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="importConfigButton" Click="ImportConfig"
                    Margin="0 5 5 5" Style="{StaticResource StyledPrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconRemixIcon Kind="FolderOpenFill" />
                    <TextBlock VerticalAlignment="Center" Margin="5 0">Import Config</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="checkProxiesButton" Click="CheckProxies"
                    Margin="0 5 5 5" Style="{StaticResource StyledPrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterialDesign Kind="VpnKey" />
                    <TextBlock VerticalAlignment="Center" Margin="5 0">Check Proxies</TextBlock>
                </StackPanel>
            </Button>

            <Button x:Name="webUIButton" Click="ShowChangelog"
                    Margin="0 5 5 5" Style="{StaticResource StyledButton}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconRadixIcons Kind="ActivityLog" />
                    <TextBlock VerticalAlignment="Center" Margin="5 0">Changelog</TextBlock>
                </StackPanel>
            </Button>

            <Button x:Name="updateButton" Click="ShowUpdateConfirmation"
                    Margin="0 5 5 5" Style="{StaticResource StyledWarningButton}"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource ResourceKey=BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconRadixIcons Kind="Update" />
                    <TextBlock VerticalAlignment="Center" Margin="5 0">Update Available!</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Announcement -->
        <TextBlock Grid.Row="5"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0 0 0 5"
                   Opacity="0.7"
                   Foreground="{DynamicResource ForegroundMain}"
                   Text="{Binding Announcement}">
        </TextBlock>
    </Grid>
</Page>
