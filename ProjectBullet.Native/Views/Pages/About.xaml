<Page x:Class="ProjectBullet.Native.Views.Pages.About"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:local="clr-namespace:ProjectBullet.Native.Views.Pages"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="780"
      Title="About">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Main content centered -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Logo -->
            <Image Source="/Images/logohq.png" Width="120" Height="120" Margin="0 0 0 20" />

            <!-- Title -->
            <TextBlock Text="ProjectBullet"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource ForegroundMain}"
                       Margin="0 0 0 8" />

            <!-- Description -->
            <TextBlock Text="Automation suite powered by .NET"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource ForegroundMain}"
                       Opacity="0.6"
                       Margin="0 0 0 15" />

            <!-- Version Info -->
            <Border Background="{DynamicResource BackgroundSecondary}"
                    CornerRadius="8" Padding="20 12"
                    HorizontalAlignment="Center" Margin="0 0 0 20">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Version " FontSize="14"
                                   Foreground="{DynamicResource ForegroundMain}" Opacity="0.7"/>
                        <TextBlock x:Name="currentVersionText" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundMain}"/>
                        <TextBlock x:Name="versionTypeText" FontSize="12"
                                   Foreground="{DynamicResource ForegroundCustom}"
                                   VerticalAlignment="Center" Margin="8 0 0 0"/>
                    </StackPanel>
                    <StackPanel x:Name="latestVersionPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0 4 0 0"
                                Visibility="Collapsed">
                        <TextBlock Text="Latest: " FontSize="12"
                                   Foreground="{DynamicResource ForegroundMain}" Opacity="0.5"/>
                        <TextBlock x:Name="latestVersionText" FontSize="12"
                                   Foreground="{DynamicResource ForegroundGood}"/>
                    </StackPanel>
                    <TextBlock x:Name="upToDateText" Text="Up to date"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource ForegroundGood}"
                               Margin="0 4 0 0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Social links -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 10">
                <Button Style="{StaticResource StyledPrimaryButton}" Click="OpenGitHub" Padding="12 8" Margin="0 0 10 0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconSimpleIcons Kind="Github" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Margin="8 0 0 0" FontSize="14">@eros1sh</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StyledPrimaryButton}" Click="OpenTelegram" Padding="12 8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconSimpleIcons Kind="Telegram" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Margin="8 0 0 0" FontSize="14">@eros_sh</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Bottom buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
            <Button x:Name="licenseButton" Style="{StaticResource StyledButton}" Click="OpenLicense" Margin="0 5 5 5">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconBootstrapIcons Kind="TextParagraph" />
                    <TextBlock VerticalAlignment="Center" Margin="5 0">License</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="repoButton" Style="{StaticResource StyledButton}" Click="OpenRepository" Margin="0 5 5 5">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconSimpleIcons Kind="Git" />
                    <TextBlock VerticalAlignment="Center" Margin="5 0">Repository</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
