<Page x:Class="ProjectBullet.Native.Views.Dialogs.AppLockDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      d:DesignHeight="250" d:DesignWidth="400"
      MinWidth="350"
      Background="{DynamicResource BackgroundSecondary}"
      Title="App Lock">

    <Border Padding="20">
        <StackPanel
            MaxWidth="400"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <iconPacks:PackIconMaterialDesign Kind="Lock"
                Width="48" Height="48"
                HorizontalAlignment="Center"
                Foreground="Gold"
                Margin="0 0 0 15" />

            <TextBlock
                Text="ProjectBullet is locked"
                FontSize="16"
                FontWeight="Bold"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="Gainsboro"
                Margin="0 0 0 5" />

            <TextBlock
                Text="Enter your password to unlock:"
                FontSize="13"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="Gray"
                Margin="0 0 0 15" />

            <PasswordBox
                x:Name="passwordBox"
                Width="250"
                Margin="0 0 0 5"
                KeyDown="PasswordBoxKeyDown" />

            <TextBlock
                x:Name="errorText"
                Text=""
                Foreground="Red"
                FontSize="12"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0 0 0 10" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Click="Unlock"
                    Margin="0 5 5 5" Style="{StaticResource StyledSuccessButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign Kind="LockOpen" />
                        <TextBlock VerticalAlignment="Center" Margin="5 0">Unlock</TextBlock>
                    </StackPanel>
                </Button>
                <Button Click="Exit"
                    Margin="0 5 5 5" Style="{StaticResource StyledDangerButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Close" />
                        <TextBlock VerticalAlignment="Center" Margin="5 0">Exit</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </Border>

</Page>
