<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             x:Class="ProjectBullet.Avalonia.Views.Dialogs.ImportProxiesDialog">

    <Grid Width="270">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Label Content="Import from:" />
            <Label x:Name="fileMode" Content="File" FontWeight="Bold" Foreground="{DynamicResource ForegroundMenuSelected}" PointerPressed="SelectFileMode" />
            <Label x:Name="pasteMode" Content="Paste" FontWeight="Bold" PointerPressed="SelectPasteMode" />
            <Label x:Name="remoteMode" Content="Remote" FontWeight="Bold" PointerPressed="SelectRemoteMode" />
        </StackPanel>

        <TabControl x:Name="modeTabControl" Background="Transparent" Grid.Row="1" Margin="5" BorderThickness="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
            </TabControl.Styles>
            <TabItem x:Name="fileTab">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="Location:" VerticalAlignment="Center"/>
                        <TextBox x:Name="locationTextbox" Grid.Column="1" VerticalContentAlignment="Center" Margin="5" IsReadOnly="True"/>
                        <icons:Icon Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Foreground="White" Value="mdi-folder" PointerPressed="SearchInFolder" />
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="pasteTab">
                <StackPanel>
                    <Label Content="Paste your proxies in the box below" />
                    <TextBox x:Name="proxiesBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="100"
                             Margin="0 5"
                             VerticalContentAlignment="Top"
                             FontFamily="Consolas"/>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="remoteTab">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="URL:" VerticalAlignment="Center"/>
                        <TextBox x:Name="urlTextbox" Grid.Column="1" VerticalContentAlignment="Center" Margin="5"/>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="advancedWarning" Grid.Row="0" Grid.ColumnSpan="2" FontFamily="Consolas" Margin="5">
                <Run FontWeight="Bold" Foreground="{DynamicResource ForegroundMain}" Text="Advanced Syntax:"/>
                <LineBreak/>
                <Run Foreground="{DynamicResource ForegroundMain}" Text="Type: (Http)1.1.1.1:80"/>
                <LineBreak/>
                <Run Foreground="{DynamicResource ForegroundMain}" Text="Auth: 1.1.1.1:80:username:password"/>
            </TextBlock>

            <Label Grid.Row="1" Grid.ColumnSpan="2" Content="Defaults (when not specified):" />

            <Label Grid.Column="0" Grid.Row="2" Content="Type:" VerticalAlignment="Center"/>
            <ComboBox x:Name="proxyTypeCombobox" Grid.Column="1" Grid.Row="2" Margin="5"/>

            <Label Grid.Column="0" Grid.Row="3" Content="Username:" />
            <TextBox x:Name="usernameTextbox" Grid.Column="1" Grid.Row="3" Margin="5"/>

            <Label Grid.Column="0" Grid.Row="4" Content="Password:" />
            <TextBox x:Name="passwordTextbox" Grid.Column="1" Grid.Row="4" Margin="5"/>

            <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5" x:Name="acceptButton" Content="ACCEPT" Click="Accept" Classes="success" Margin="5"/>
        </Grid>
    </Grid>
</UserControl>
