<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProjectBullet.Avalonia.Views.Dialogs.CreateJobDialog">

    <Border Padding="20">
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center">
            <Button Click="CreateMultiRunJob" Margin="0 0 0 5"
                        Classes="primary" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="5 0">Multi Run</TextBlock>
                </StackPanel>
            </Button>

            <Button Click="CreateProxyCheckJob"
                        Classes="primary" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="5 0">Proxy Check</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
