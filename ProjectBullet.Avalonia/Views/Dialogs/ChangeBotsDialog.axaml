<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProjectBullet.Avalonia.Views.Dialogs.ChangeBotsDialog">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NumericUpDown
            x:Name="bots"
            Grid.Row="0"
            Minimum="1"
            Maximum="200"
            Increment="1"
            Width="150"/>

        <Button
            Grid.Row="1"
            Content="ACCEPT"
            Click="Accept"
            Classes="success"
            Margin="0 5 0 0"/>

    </Grid>
</UserControl>
