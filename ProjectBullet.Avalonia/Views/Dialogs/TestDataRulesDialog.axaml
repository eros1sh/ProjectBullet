<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             x:Class="ProjectBullet.Avalonia.Views.Dialogs.TestDataRulesDialog">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
            <Label FontWeight="Bold" Content="Wordlist Type:" />
            <Label Content="{Binding WordlistType}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center">
            <Label FontWeight="Bold" Content="Regex Validation:" />
            <icons:Icon Value="{Binding RegexValidation.IconValue}" Foreground="{Binding RegexValidation.Color}" VerticalAlignment="Center" />
            <Label Content="{Binding RegexValidation.Result}" />
        </StackPanel>

        <Separator Grid.Row="2" Opacity="0.5" Margin="0 5 0 0" />

        <Label FontWeight="Bold" Grid.Row="3" Content="Slices by separator:" />

        <ItemsControl ItemsSource="{Binding SlicesCollection}" Grid.Row="4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 -5 0 -5">
                        <Label Content="{Binding Name}" />
                        <Label Content="=" />
                        <Label Content="{Binding Value}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Separator Grid.Row="5" Opacity="0.5" Margin="0 5 0 0" />
        <Label FontWeight="Bold" Grid.Row="6" Content="Results:" />
        <ScrollViewer MaxHeight="300" Grid.Row="7" Margin="5 0 0 0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ResultsCollection}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <icons:Icon Value="{Binding IconValue}" Foreground="{Binding Color}" VerticalAlignment="Center" />
                            <Label Content="{Binding Text}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
