<UserControl x:Class="ProjectBullet.Avalonia.Views.Pages.ConfigSettings"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ProjectBullet.Avalonia.Views.Pages"
      xmlns:uc="clr-namespace:ProjectBullet.Avalonia.Controls"
      xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
      xmlns:resources="clr-namespace:RuriLib.Models.Data.Resources.Options;assembly=RuriLib"
      xmlns:rules="clr-namespace:RuriLib.Models.Data.Rules;assembly=RuriLib"
      mc:Ignorable="d"
      d:DesignHeight="2750" d:DesignWidth="800">

    <Grid>
        <ScrollViewer Grid.Row="0" Grid.ColumnSpan="2"
                      HorizontalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,10" HorizontalAlignment="Stretch">
                <TextBlock FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Text="General"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Suggested amount of bots" VerticalAlignment="Center" Margin="5,0"/>
                    <NumericUpDown Minimum="1"
                          Maximum="1000"
                          Increment="1"
                          Value="{Binding SuggestedBots}"
                          Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Maximum CPM (0 to disable)" VerticalAlignment="Center" Margin="5,0"/>
                    <NumericUpDown Minimum="0"
                          Maximum="1000000"
                          Increment="1"
                          Value="{Binding MaximumCPM}"
                          Width="150"/>
                </StackPanel>
                <CheckBox Content="Save empty captures"
                          IsChecked="{Binding SaveEmptyCaptures}"
                          Margin="5,10,0,0"/>
                <CheckBox Content="Report the last captcha if the bot ends with a RETRY status"
                          IsChecked="{Binding ReportLastCaptchaOnRetry}"
                          Margin="5,10,0,0"/>
                <TextBlock Margin="5,10,0,0" Text="Statuses for which the bot will continue / stop"/>
                <uc:MultipleSelector
                    SelectedValues="{Binding ContinueStatuses, Mode=TwoWay}"
                    PossibleValues="{Binding AllStatuses}"/>
                <Separator Opacity="0.5" Margin="5,20"/>
                <TextBlock FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Text="Proxies"/>
                <CheckBox Content="Use proxies"
                          IsChecked="{Binding UseProxies}"
                          Margin="5,0,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Maximum uses after which a proxy is banned (0 to disable)" VerticalAlignment="Center" Margin="5,0"/>
                    <NumericUpDown Minimum="0"
                          Maximum="1000000"
                          Increment="1"
                          Value="{Binding MaxUsesPerProxy}"
                          Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Ban loop evasion (number of times a data line can be retried before being marked as ToCheck, 0 to disable)" VerticalAlignment="Center" Margin="5,0"/>
                    <NumericUpDown Minimum="0"
                          Maximum="1000000"
                          Increment="1"
                          Value="{Binding BanLoopEvasion}"
                          Width="150"/>
                </StackPanel>
                <TextBlock Margin="5,10,0,0" Text="Ban the proxy when the bot ends with one of these statuses"/>
                <uc:MultipleSelector
                    SelectedValues="{Binding ProxyBanStatuses, Mode=TwoWay}"
                    PossibleValues="{Binding AllStatuses}"/>
                <TextBlock Margin="5,10,0,0" Text="Allowed proxy types"/>
                <uc:MultipleSelector
                    SelectedValues="{Binding AllowedProxyTypes, Mode=TwoWay}"
                    PossibleValues="{Binding ProxyTypes}"/>
                <Separator Opacity="0.5" Margin="5,20"/>
                <TextBlock FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Text="Data"/>
                <TextBlock Margin="5,10,0,0" Text="Allowed wordlist types"/>
                <uc:MultipleSelector
                    SelectedValues="{Binding AllowedWordlistTypes, Mode=TwoWay}"
                    PossibleValues="{Binding WordlistTypes}"/>
                <CheckBox Content="URL Encode data after slicing"
                          IsChecked="{Binding UrlEncodeDataAfterSlicing}"
                          Margin="5,10,0,0"/>
                <TextBlock Foreground="{DynamicResource ForegroundCustom}" Margin="5,10,0,0" Text="Rules"/>
                <StackPanel Orientation="Horizontal">
                    <Button Click="AddSimpleDataRule" Margin="5"
                        Classes="success"
                        Width="70" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <icons:Icon Value="mdi-plus" />
                            <TextBlock VerticalAlignment="Center" Margin="5,0">Simple</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="AddRegexDataRule" Margin="5"
                        Classes="success"
                        Width="70" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <icons:Icon Value="mdi-plus" />
                            <TextBlock VerticalAlignment="Center" Margin="5,0">Regex</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding DataRulesCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Test your data here:" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Grid.Column="1" Text="{Binding TestDataForRules}" Margin="5" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding WordlistTypes}" SelectedValue="{Binding TestWordlistTypeForRules}" Margin="5" />
                    <Button Grid.Column="3" Click="TestDataRules" Margin="5"
                        Classes="primary"
                        HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <icons:Icon Value="mdi-test-tube" />
                            <TextBlock VerticalAlignment="Center" Margin="5,0">Test</TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Foreground="{DynamicResource ForegroundCustom}" Margin="5,10,0,0" Text="Resources"/>
                <StackPanel Orientation="Horizontal">
                    <Button Click="AddLinesFromFileResource" Margin="5"
                        Classes="success"
                        Width="110" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <icons:Icon Value="mdi-plus" />
                            <TextBlock VerticalAlignment="Center" Margin="5,0">Lines from file</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="AddRandomLinesFromFileResource" Margin="5"
                        Classes="success"
                        Width="150" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <icons:Icon Value="mdi-plus" />
                            <TextBlock VerticalAlignment="Center" Margin="5,0">Random lines from file</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ResourcesCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Separator Opacity="0.5" Margin="5,20"/>
                <TextBlock FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Text="Inputs"/>
                <TextBlock Foreground="{DynamicResource ForegroundCustom}" Margin="5,10,0,0" Text="Custom inputs"/>
                <Button x:Name="addCustomInputButton" Click="AddCustomInput" Margin="5"
                        Classes="success"
                        Width="70" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <icons:Icon Value="mdi-plus" />
                        <TextBlock VerticalAlignment="Center" Margin="5,0">Add</TextBlock>
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="customInputsControl" ItemsSource="{Binding CustomInputsCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Separator Opacity="0.5" Margin="5,20"/>
                <TextBlock FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Text="Puppeteer"/>
                <TextBlock Margin="5,10,0,0" Text="Quit the browser when the bot ends with one of these statuses"/>
                <uc:MultipleSelector
                    SelectedValues="{Binding QuitBrowserStatuses, Mode=TwoWay}"
                    PossibleValues="{Binding AllStatuses}"/>
                <CheckBox Content="Headless mode"
                          IsChecked="{Binding Headless}"
                          Margin="5,10,0,0"/>
                <CheckBox Content="Load only document and script"
                          IsChecked="{Binding LoadOnlyDocumentAndScript}"
                          Margin="5,10,0,0"/>
                <CheckBox Content="Dismiss dialogs"
                          IsChecked="{Binding DismissDialogs}"
                          Margin="5,10,0,0"/>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Command line arguments" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox DockPanel.Dock="Left" Text="{Binding CommandLineArgs}" />
                </DockPanel>
                <CheckBox Content="Ignore HTTPS errors"
                          IsChecked="{Binding IgnoreHttpsErrors}"
                          Margin="5,10,0,0"/>
                <TextBlock Margin="5,10,0,0" Text="Blocked URLs (one per line)"/>
                <TextBox x:Name="blockedUrlsTextBox"
                             Background="{DynamicResource BackgroundSecondary}"
                             Foreground="{DynamicResource ForegroundMain}"
                             FontFamily="Consolas"
                             Margin="5"
                             Height="100"
                             AcceptsReturn="True"
                             TextChanged="BlockedUrlsChanged" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
