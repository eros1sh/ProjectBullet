<UserControl x:Class="ProjectBullet.Avalonia.Views.Pages.ProxyCheckJobViewer"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ProjectBullet.Avalonia.Views.Pages"
      xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
      xmlns:controls="clr-namespace:ProjectBullet.Avalonia.Controls"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Job options -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Margin="5,0">Url:</TextBlock>
                    <TextBlock Text="{Binding Job.Url}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Margin="5,0">Success key:</TextBlock>
                    <TextBlock Text="{Binding Job.SuccessKey}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Margin="5,0">Check only untested:</TextBlock>
                    <TextBlock Text="{Binding Job.CheckOnlyUntested}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Margin="5,0">Timeout (ms):</TextBlock>
                    <TextBlock Text="{Binding Job.TimeoutMilliseconds}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Margin="5,0">Bots:</TextBlock>
                    <TextBlock Text="{Binding Job.Bots}" VerticalAlignment="Center" />
                    <icons:Icon
                        Foreground="{DynamicResource ForegroundMain}"
                        Margin="5,0,0,0"
                        Value="mdi-pencil"
                        Cursor="Hand"
                        PointerPressed="ChangeBots" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding RemainingWaitString}"
                       IsVisible="{Binding IsWaiting}" VerticalAlignment="Center" />
                <TextBlock Text="Stopping..."
                       IsVisible="{Binding IsStopping}" VerticalAlignment="Center" />
                <TextBlock Text="Pausing..."
                       IsVisible="{Binding IsPausing}" VerticalAlignment="Center" />
                <Button Click="Start"
                    IsVisible="{Binding CanStart}"
                    Classes="success">
                    <StackPanel Orientation="Horizontal">
                        <icons:Icon Value="mdi-play" />
                        <TextBlock VerticalAlignment="Center" Margin="5,0">Start</TextBlock>
                    </StackPanel>
                </Button>
                <Button Click="Resume"
                    IsVisible="{Binding CanResume}"
                    Margin="2,0,0,0" Classes="success">
                    <StackPanel Orientation="Horizontal">
                        <icons:Icon Value="mdi-play" />
                        <TextBlock VerticalAlignment="Center" Margin="5,0">Resume</TextBlock>
                    </StackPanel>
                </Button>
                <Button Click="Pause"
                    IsVisible="{Binding CanPause}"
                    Margin="2,0,0,0" Classes="warning">
                    <StackPanel Orientation="Horizontal">
                        <icons:Icon Value="mdi-pause" />
                        <TextBlock VerticalAlignment="Center" Margin="5,0">Pause</TextBlock>
                    </StackPanel>
                </Button>
                <Button Click="SkipWait"
                    IsVisible="{Binding CanSkipWait}"
                    Margin="2,0,0,0" Classes="primary">
                    <StackPanel Orientation="Horizontal">
                        <icons:Icon Value="mdi-fast-forward" />
                        <TextBlock VerticalAlignment="Center" Margin="5,0">Skip wait</TextBlock>
                    </StackPanel>
                </Button>
                <Button Click="Stop"
                    IsVisible="{Binding CanStop}"
                    Margin="2,0,0,0" Classes="danger">
                    <StackPanel Orientation="Horizontal">
                        <icons:Icon Value="mdi-stop" />
                        <TextBlock VerticalAlignment="Center" Margin="5,0">Stop</TextBlock>
                    </StackPanel>
                </Button>
                <Button Click="Abort"
                    IsVisible="{Binding CanAbort}"
                    Margin="2,0,0,0" Classes="danger">
                    <StackPanel Orientation="Horizontal">
                        <icons:Icon Value="mdi-close-outline" />
                        <TextBlock VerticalAlignment="Center" Margin="5,0">Abort</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="1" Margin="5,2" Height="24">
            <ProgressBar
                Minimum="0"
                Maximum="100"
                Height="20"
                Value="{Binding Progress, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding Job.ProgressString}"
                FontWeight="Bold"
                FontSize="11" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontWeight="Bold" Margin="5,5,0,0">PROXIES</TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" Margin="5,0">Total:</TextBlock>
                    <TextBlock Text="{Binding Job.Total}" Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" Margin="5,0">Tested:</TextBlock>
                    <TextBlock Text="{Binding Job.Tested}" Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource ForegroundGood}">Working:</TextBlock>
                    <TextBlock Text="{Binding Job.Working}" Foreground="{DynamicResource ForegroundGood}" Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource ForegroundBad}">Not working:</TextBlock>
                    <TextBlock Text="{Binding Job.NotWorking}" Foreground="{DynamicResource ForegroundBad}" Margin="5,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock FontWeight="Bold" Margin="5,5,0,0">OTHERS</TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" Margin="5,0">CPM:</TextBlock>
                    <TextBlock Text="{Binding Job.CPM}" Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" Margin="5,0">Elapsed:</TextBlock>
                    <TextBlock Text="{Binding Job.ElapsedString}" Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" Margin="5,0">Remaining:</TextBlock>
                    <TextBlock Text="{Binding Job.RemainingString}" Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock FontWeight="Bold" Margin="5,0">Progress:</TextBlock>
                    <TextBlock Text="{Binding Job.ProgressString}" Margin="5,0,0,0" />
                </StackPanel>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="3" Margin="0,5,0,0">
            <controls:ColoredLog
                Grid.Column="0"
                x:Name="jobLog" />
        </Grid>
    </Grid>
</UserControl>
