<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProjectBullet.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- App Colors -->
            <SolidColorBrush x:Key="ThemeMain" Color="#8B5CF6" />
            <SolidColorBrush x:Key="BackgroundMain" Color="#0F0F0F" />
            <SolidColorBrush x:Key="BackgroundSecondary" Color="#0A0A0A" />
            <SolidColorBrush x:Key="BackgroundInput" Color="#1A1A1A" />
            <SolidColorBrush x:Key="ForegroundMain" Color="#DCDCDC" />
            <SolidColorBrush x:Key="ForegroundInput" Color="#DCDCDC" />
            <SolidColorBrush x:Key="ForegroundGood" Color="#ADFF2F"/>
            <SolidColorBrush x:Key="ForegroundBad" Color="#FF6347"/>
            <SolidColorBrush x:Key="ForegroundCustom" Color="#FF8C00"/>
            <SolidColorBrush x:Key="ForegroundRetry" Color="#FFFF00"/>
            <SolidColorBrush x:Key="ForegroundBanned" Color="#DDA0DD"/>
            <SolidColorBrush x:Key="ForegroundToCheck" Color="#7FFFD4"/>
            <SolidColorBrush x:Key="ForegroundMenuSelected" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="Headers" />

            <SolidColorBrush x:Key="SuccessButton" Color="#065F46"/>
            <SolidColorBrush x:Key="SuccessButtonHover" Color="#047857"/>
            <SolidColorBrush x:Key="PrimaryButton" Color="#5B21B6"/>
            <SolidColorBrush x:Key="PrimaryButtonHover" Color="#6D28D9"/>
            <SolidColorBrush x:Key="WarningButton" Color="#92400E"/>
            <SolidColorBrush x:Key="WarningButtonHover" Color="#B45309"/>
            <SolidColorBrush x:Key="DangerButton" Color="#991B1B"/>
            <SolidColorBrush x:Key="DangerButtonHover" Color="#B91C1C"/>
            <SolidColorBrush x:Key="ForegroundButton" Color="#EFEFEF"/>
            <SolidColorBrush x:Key="BackgroundButton" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="BackgroundButtonHover" Color="#2A2A2A"/>

            <!-- Override Fluent theme resources for dark mode -->
            <Color x:Key="SystemAccentColor">#8B5CF6</Color>
            <Color x:Key="SystemAccentColorDark1">#7C3AED</Color>
            <Color x:Key="SystemAccentColorDark2">#6D28D9</Color>
            <Color x:Key="SystemAccentColorDark3">#5B21B6</Color>
            <Color x:Key="SystemAccentColorLight1">#A78BFA</Color>
            <Color x:Key="SystemAccentColorLight2">#C4B5FD</Color>
            <Color x:Key="SystemAccentColorLight3">#DDD6FE</Color>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- ============================== -->
        <!-- Global Font & TextBlock -->
        <!-- ============================== -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}"/>
            <Setter Property="FontFamily" Value="Segoe UI, San Francisco, Helvetica Neue, Arial, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============================== -->
        <!-- Window -->
        <!-- ============================== -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Segoe UI, San Francisco, Helvetica Neue, Arial, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============================== -->
        <!-- TextBox -->
        <!-- ============================== -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundInput}"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundInput}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeMain}"/>
        </Style>

        <!-- ============================== -->
        <!-- CheckBox -->
        <!-- ============================== -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}"/>
        </Style>

        <!-- ============================== -->
        <!-- ComboBox -->
        <!-- ============================== -->
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundInput}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundInput}"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontFamily" Value="Segoe UI, San Francisco, Arial, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============================== -->
        <!-- AutoCompleteBox -->
        <!-- ============================== -->
        <Style Selector="AutoCompleteBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundInput}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundInput}"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============================== -->
        <!-- NumericUpDown -->
        <!-- ============================== -->
        <Style Selector="NumericUpDown">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundInput}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundInput}"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ============================== -->
        <!-- DataGrid -->
        <!-- ============================== -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1E1E1E"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#1E1E3A"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#2D1B69"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- ============================== -->
        <!-- Buttons -->
        <!-- ============================== -->

        <!-- Base styled button -->
        <Style Selector="Button.styled">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundButton}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundButton}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
        </Style>
        <Style Selector="Button.styled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BackgroundButtonHover}"/>
        </Style>
        <Style Selector="Button.styled:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <!-- Danger button -->
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundButton}"/>
            <Setter Property="Background" Value="{DynamicResource DangerButton}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonHover}"/>
        </Style>

        <!-- Success button -->
        <Style Selector="Button.success">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundButton}"/>
            <Setter Property="Background" Value="{DynamicResource SuccessButton}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SuccessButtonHover}"/>
        </Style>

        <!-- Warning button -->
        <Style Selector="Button.warning">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundButton}"/>
            <Setter Property="Background" Value="{DynamicResource WarningButton}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningButtonHover}"/>
        </Style>

        <!-- Primary button -->
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundButton}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButton}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonHover}"/>
        </Style>

        <!-- ============================== -->
        <!-- Menu TextBlock hover -->
        <!-- ============================== -->
        <Style Selector="TextBlock.menuItem">
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.menuItem:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeMain}"/>
        </Style>

        <!-- Active menu item -->
        <Style Selector="TextBlock.menuActive">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMenuSelected}"/>
        </Style>

        <!-- ============================== -->
        <!-- ScrollViewer / ScrollBar -->
        <!-- ============================== -->
        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ============================== -->
        <!-- ToolTip -->
        <!-- ============================== -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ============================== -->
        <!-- ContextMenu -->
        <!-- ============================== -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- ============================== -->
        <!-- TabControl -->
        <!-- ============================== -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}"/>
        </Style>

        <!-- ============================== -->
        <!-- Separator -->
        <!-- ============================== -->
        <Style Selector="Separator">
            <Setter Property="Background" Value="#222222"/>
        </Style>

    </Application.Styles>
</Application>
